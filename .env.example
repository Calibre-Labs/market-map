PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
FRONTEND_ORIGIN=https://mmap.calibrelabs.ai
COOKIE_DOMAIN=.calibrelabs.ai
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=market-map
BRAINTRUST_ERROR_WINDOW_MS=60000
BRAINTRUST_ERROR_THRESHOLD=3
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_SWEEP_INTERVAL_MS=300000
SESSION_SWEEP_BATCH_SIZE=100
SQLITE_PATH=./data/market-map.sqlite
# Railway: mount a Volume at /app/data and set either:
# SQLITE_PATH=/app/data/market-map.sqlite
# or RAILWAY_VOLUME_MOUNT_PATH=/app/data
